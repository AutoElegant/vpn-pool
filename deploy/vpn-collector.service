[Unit]
Description=Сборщик бесплатных VLESS-конфигов
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vpnbot
WorkingDirectory=/opt/vpnbot
ExecStart=/opt/vpnbot/venv/bin/python -m core.collector
TimeoutStartSec=2400
Nice=10

# Изоляция
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vpnbot/data

[Install]
WantedBy=multi-user.target
