# Скопировать в .env и заполнить. Сам .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=
# ID админов через запятую (свой можно узнать у @userinfobot)
ADMIN_IDS=
# Юзернейм бота без @ — подставляется в названия конфигов внутри клиента
BOT_USERNAME=
# Необязательно: канал, подписка на который нужна перед выдачей конфига
REQUIRED_CHANNEL=

# Откуда сервер берёт готовый пул (raw-ссылка на data/pool.json)
POOL_URL=
# Нужен только для приватного репозитория
GITHUB_TOKEN=
