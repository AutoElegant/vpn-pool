# Токен от @BotFather
BOT_TOKEN=123456:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789
# Юзернейм бота без @ — подставляется в названия конфигов
BOT_USERNAME=my_free_vpn_bot
# Необязательно: канал, на который надо подписаться перед выдачей конфига (@channel или -100...)
REQUIRED_CHANNEL=
# Откуда VPS берёт готовый пул (raw-ссылка на data/pool.json из твоего репозитория)
POOL_URL=https://raw.githubusercontent.com/USER/REPO/main/data/pool.json
# Нужен только если репозиторий приватный (тогда Actions платные сверх 2000 мин/мес)
GITHUB_TOKEN=
